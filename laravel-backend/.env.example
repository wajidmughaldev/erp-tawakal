APP_NAME="Tawakal ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tawakal_erp
DB_USERNAME=tawakal_erp
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
FRONTEND_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8001
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Optional dedicated HMAC key for exact CNIC lookup; defaults to APP_KEY.
EMPLOYEE_LOOKUP_KEY=

# Keep unconfigured until the card validity product decision is approved.
CARD_VALIDITY_POLICY=eleven_months

# First superadmin, created by `php artisan db:seed` (never overwrites an existing account)
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Password reset links point here
FRONTEND_URL=http://localhost:3000

# Mail for password reset emails. Use smtp in production (e.g. Gmail needs an App Password).
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tawakal Ent."
