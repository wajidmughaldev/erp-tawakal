# Laravel settings for https://ems.tawakalent.com
# Copy this file to  ems-laravel/.env  on the server (name it exactly ".env") and fill in every value marked CHANGE.
# Never share this file or put it inside public_html.

APP_NAME="Tawakal Enterprises"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ems.tawakalent.com
# Generate with:  php artisan key:generate --show      (see DEPLOY.md). Back it up: without it stored data cannot be read.
APP_KEY=CHANGE

# Used to find employees by CNIC without storing the CNIC in clear text. Generate a random 64-character
# value ONCE and never change it, or CNIC duplicate checks stop working. Back it up with APP_KEY.
EMPLOYEE_LOOKUP_KEY=CHANGE

# --- Database (hPanel > Databases > MySQL Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE
DB_USERNAME=CHANGE
DB_PASSWORD=CHANGE

# --- Sessions / security ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SANCTUM_STATEFUL_DOMAINS=ems.tawakalent.com
FRONTEND_ORIGINS=https://ems.tawakalent.com
FRONTEND_URL=https://ems.tawakalent.com
BCRYPT_ROUNDS=12

CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Logs (kept 14 days) ---
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- ID cards ---
CARD_VALIDITY_POLICY=eleven_months

# --- Email (password reset). Create a mailbox in hPanel > Emails first, e.g. noreply@tawakalent.com ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=CHANGE
MAIL_PASSWORD=CHANGE
MAIL_FROM_ADDRESS=CHANGE
MAIL_FROM_NAME="Tawakal Enterprises"

# --- First superadmin: used only by `php artisan db:seed`, then DELETE these three lines from the file ---
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=CHANGE
SUPERADMIN_PASSWORD=CHANGE
